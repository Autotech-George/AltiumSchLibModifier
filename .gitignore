# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Input/output libraries are kept out of version control (they may be
# proprietary). Keep the folders, ignore the .SchLib files themselves —
# at any depth, so backup subfolders are covered too.
/input/**/*.SchLib
/output/**/*.SchLib

# Local Altium projects used for manual testing (proprietary designs)
/altium_test_projects/

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
